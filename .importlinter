[importlinter]
root_packages =
    keel_core
    reference_service
include_external_packages = True

[importlinter:contract:layers]
name = keel_core hexagonal layers
type = layers
layers =
    keel_core.adapters
    keel_core.application
    keel_core.domain
    keel_core.ports

[importlinter:contract:domain-no-infra]
name = domain and ports are free of I/O libraries
type = forbidden
source_modules =
    keel_core.domain
    keel_core.ports
forbidden_modules =
    sqlalchemy
    fastapi
    grpc
    httpx

[importlinter:contract:ref-layers]
name = reference_service hexagonal layers
type = layers
layers =
    reference_service.adapters
    reference_service.application
    reference_service.domain

[importlinter:contract:ref-domain-no-infra]
name = reference_service domain is free of I/O libraries
type = forbidden
source_modules =
    reference_service.domain
forbidden_modules =
    sqlalchemy
    fastapi
    grpc
    httpx

# The reference service's driving (inbound) adapter must not import its own driven
# (outbound) adapter: the composition root owns that binding. The single-layer
# `adapters` contract cannot see this split, so guard it explicitly. (keel-core's
# create_app keeps a StructuredLogger default as a documented library fallback, so
# this guards the exemplar service, which must model clean composition-root wiring.)
[importlinter:contract:ref-inbound-not-outbound]
name = reference_service inbound adapters do not import outbound adapters
type = forbidden
source_modules =
    reference_service.adapters.inbound
forbidden_modules =
    reference_service.adapters.outbound
