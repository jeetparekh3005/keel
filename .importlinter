[importlinter]
root_packages =
    keel_core
    reference_service
include_external_packages = True

[importlinter:contract:layers]
name = keel_core hexagonal layers
type = layers
layers =
    keel_core.adapters
    keel_core.application
    keel_core.domain

[importlinter:contract:domain-no-infra]
name = domain is free of I/O libraries
type = forbidden
source_modules =
    keel_core.domain
forbidden_modules =
    sqlalchemy
    fastapi
    grpc
    httpx

[importlinter:contract:ref-layers]
name = reference_service hexagonal layers
type = layers
layers =
    reference_service.adapters
    reference_service.application
    reference_service.domain

[importlinter:contract:ref-domain-no-infra]
name = reference_service domain is free of I/O libraries
type = forbidden
source_modules =
    reference_service.domain
forbidden_modules =
    sqlalchemy
    fastapi
    grpc
    httpx
