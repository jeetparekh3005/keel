{
  "name": "@keel/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared keel platform library for the TypeScript/NestJS vertical: config, errors, logging, telemetry, HTTP edge, OIDC auth, persistence, ports, and the conformance suite.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "default": "./dist/testkit/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.301.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/testing": "12.4.2",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
