<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.keel</groupId>
    <artifactId>keel-java-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>keel-core</artifactId>
  <name>keel-core (Java)</name>
  <description>Shared keel platform library for the Java/Spring Boot vertical: config, errors, logging, telemetry, HTTP edge, OIDC auth, persistence, ports, and the conformance suite.</description>

  <!-- Align the whole gRPC stack to one release (ADR-0022): the committed stubs were generated
       against grpc 1.85.1, but grpc-api/grpc-protobuf-lite arrive transitively at an older patch.
       The grpc BOM pins every io.grpc artifact (api, core, netty-shaded, inprocess, stub, protobuf)
       to 1.85.1 so the runtime and the generated stubs cannot skew. The OpenTelemetry instrumentation
       BOM (alpha) pins the gRPC tracing interceptor to the same core OTel release (1.62.0) that the
       Spring Boot BOM manages, so the OTel API on the classpath stays single-versioned. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>1.85.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-instrumentation-bom-alpha</artifactId>
        <version>2.28.1-alpha</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Actuator brings the Micrometer tracing + OpenTelemetry auto-configuration that
         instantiates the Tracer, the OTLP span exporter, and the MDC trace-correlation bridge;
         without it the tracing library jars are inert and logs carry no trace id. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Boot 4 split tracing out of actuator: these auto-configure the Micrometer Tracer over
         the OpenTelemetry SDK (the MDC trace-correlation bridge) and the OTLP exporter. Without
         them the tracing library jars are inert and logs carry no trace id. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- The metrics counterpart of the OTLP span exporter: a Micrometer MeterRegistry that pushes
         http.server.requests (and the rest of the actuator meter set) over OTLP. Without a registry
         on the classpath actuator records the timers in-memory but exports nothing. Boot's OTLP
         metrics auto-config binds it; export is enabled only when KEEL_OTLP_ENDPOINT is set
         (KeelEnvironmentPostProcessor), mirroring how the trace exporter is gated. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-otlp</artifactId>
    </dependency>
    <!-- Official NATS client for the JetStream MessageBus adapter (ADR-0012, platform.yaml
         interservice.async default_adapter: nats_jetstream). Not managed by the Spring Boot BOM, so
         the version is pinned here. The adapter is wired only when KEEL_NATS_URL is set
         (MessagingAutoConfiguration); a service without a broker still carries the jar but never
         opens a connection. -->
    <dependency>
      <groupId>io.nats</groupId>
      <artifactId>jnats</artifactId>
      <version>2.26.4</version>
    </dependency>
    <!-- gRPC contract (ADR-0022): runtime for the committed keel.reference.v1 stubs under
         io.keel.reference.v1 (generated by buf, see buf.gen.yaml) and the inbound gRPC server.
         protobuf-java is pinned to the gencode version the stubs were generated against (4.36.2);
         the io.grpc artifacts are managed by the grpc BOM above. grpc-netty-shaded is the transport
         that backs Grpc.newServerBuilderForPort / TlsServerCredentials at runtime (a service that
         depends on keel-core inherits it); grpc-protobuf/grpc-stub back the generated service. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>4.36.2</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>
    <!-- The gRPC tracing server interceptor (ADR-0022): mirrors the Python vertical's
         aio_server_interceptor. Installed by the server factory so every served method is traced;
         pinned to the Spring-Boot-managed OTel core release via the instrumentation BOM. -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-grpc-1.6</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- In-process gRPC transport for the server/interceptor tests: no socket, so the deny-by-default
         auth, per-method scopes, and principal propagation are exercised end to end without a port.
         The mTLS test uses a real loopback (netty-shaded) on an ephemeral port. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Generates the throwaway mTLS PKI in-process (TestPki), so no key material is committed;
         matches the runtime cert-generation the other verticals use. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>1.79</version>
      <scope>test</scope>
    </dependency>
    <!-- InMemorySpanExporter + the SDK tracer-provider test harness, used to prove the redacting
         span exporter scrubs secrets on export. Version is managed by the OpenTelemetry BOM that
         Spring Boot's dependency management imports (same source as the SDK trace classes). -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.5.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
