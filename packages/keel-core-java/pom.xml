<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.keel</groupId>
    <artifactId>keel-java-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>keel-core</artifactId>
  <name>keel-core (Java)</name>
  <description>Shared keel platform library for the Java/Spring Boot vertical: config, errors, logging, telemetry, HTTP edge, OIDC auth, persistence, ports, and the conformance suite.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Actuator brings the Micrometer tracing + OpenTelemetry auto-configuration that
         instantiates the Tracer, the OTLP span exporter, and the MDC trace-correlation bridge;
         without it the tracing library jars are inert and logs carry no trace id. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Boot 4 split tracing out of actuator: these auto-configure the Micrometer Tracer over
         the OpenTelemetry SDK (the MDC trace-correlation bridge) and the OTLP exporter. Without
         them the tracing library jars are inert and logs carry no trace id. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- The metrics counterpart of the OTLP span exporter: a Micrometer MeterRegistry that pushes
         http.server.requests (and the rest of the actuator meter set) over OTLP. Without a registry
         on the classpath actuator records the timers in-memory but exports nothing. Boot's OTLP
         metrics auto-config binds it; export is enabled only when KEEL_OTLP_ENDPOINT is set
         (KeelEnvironmentPostProcessor), mirroring how the trace exporter is gated. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.5.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
