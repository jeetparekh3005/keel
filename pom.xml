<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Aggregator + parent for the Java vertical (ADR-0020). The JVM analog of go.work / the
    pnpm workspace: it ties the shared library and the reference service into one reactor and
    centralizes dependency + plugin management via the Spring Boot BOM. The Python, Rust, Go,
    and TypeScript verticals live beside it under packages/ and services/.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.keel</groupId>
  <artifactId>keel-java-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>keel Java vertical</name>

  <modules>
    <module>packages/keel-core-java</module>
    <module>services/reference-service-java</module>
    <!-- Build-only cross-module coverage gate (epic #419). Ships no artifact, not templated. It
         depends on the two modules above so the reactor builds it last, after their exec data
         exists, and its jacoco:report-aggregate + check enforce the 85% aggregate line floor. -->
    <module>coverage-aggregate</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Per-module JaCoCo floors (epic #419, v0.6 parity). These are the default (keel-core-java)
         minima; reference-service-java overrides them with its own, higher floors in its pom.
         The values lock the real measured coverage just under the observed number so the gate
         blocks any regression; each module sets the highest round value its real coverage clears.
         See the jacoco check rule below for how they are applied. -->
    <jacoco.line.min>0.30</jacoco.line.min>
    <jacoco.branch.min>0.40</jacoco.branch.min>
  </properties>

  <build>
    <plugins>
      <!-- Format gate (the JVM analog of gofmt/prettier/ruff-format): google-java-format,
           enforced on `mvn verify`. Also strips unused imports. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>2.0.0</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Coverage report + a per-module hard floor so coverage cannot silently regress. The
           floor is the real measured coverage, rounded down, and set per module via the
           jacoco.line.min / jacoco.branch.min properties (default here, overridden in
           reference-service-java). keel-core-java's web/auth classes (Conformance, SecurityConfig,
           ProblemExceptionHandler, the HTTP-edge filters, CORS) are exercised by the reference
           service's conformance tests, not keel-core's own tests, so its per-module number
           undercounts and sits well below the Python vertical's 85% line floor; a cross-module
           report-aggregate that counts that coverage against keel-core is the path to parity. Until
           then the floor blocks a real regression in either module. -->
      <!-- Measured (mvn verify, Postgres + live Keycloak): keel-core-java LINE 0.3445 / BRANCH
           0.4127; reference-service-java LINE 0.6914 / BRANCH 0.5000. Floors are set just under. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.16</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.min}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.branch.min}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
