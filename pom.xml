<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Aggregator + parent for the Java vertical (ADR-0020). The JVM analog of go.work / the
    pnpm workspace: it ties the shared library and the reference service into one reactor and
    centralizes dependency + plugin management via the Spring Boot BOM. The Python, Rust, Go,
    and TypeScript verticals live beside it under packages/ and services/.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.github.jeetparekh3005</groupId>
  <artifactId>keel-java-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>keel Java vertical</name>
  <!-- Maven Central (Sonatype Central Portal) requires every published POM to carry description,
       url, licenses, developers, and scm (ADR-0028, #422). keel-core-java is the artifact that
       ships; this parent pom is deployed alongside it (keel-core names it as <parent>), so the
       required metadata lives here and is inherited by keel-core (which adds only its own name +
       description). The groupId is io.github.jeetparekh3005 because the project does not own a
       keel.io domain: Sonatype Central auto-verifies a GitHub-based namespace (io.github.<user>)
       against the GitHub account, so no DNS TXT record is needed. -->
  <description>Aggregator and parent pom for the keel Java/Spring Boot vertical: pins the Spring Boot BOM, the shared dependency/plugin management, and the format/coverage/CVE gates inherited by keel-core-java and the reference service.</description>
  <url>https://github.com/jeetparekh3005/keel</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>jeetparekh3005</id>
      <name>jeetparekh3005</name>
      <email>jeetparekh3005@gmail.com</email>
      <url>https://github.com/jeetparekh3005</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/jeetparekh3005/keel.git</connection>
    <developerConnection>scm:git:git@github.com:jeetparekh3005/keel.git</developerConnection>
    <url>https://github.com/jeetparekh3005/keel</url>
  </scm>

  <modules>
    <module>packages/keel-core-java</module>
    <module>services/reference-service-java</module>
  </modules>

  <!-- The build-only cross-module coverage gate (epic #419) lives behind a profile, NOT in the
       default reactor: a generated standalone service has no such module, and keeping it out of the
       default build means the service image (and the byte-identical template dogfood) need no
       reference to it. CI runs `mvn -Pcoverage-aggregate verify` to enforce the 85% aggregate line
       floor; the aggregator depends on both modules so it builds last, after their exec data exists. -->
  <profiles>
    <profile>
      <id>coverage-aggregate</id>
      <modules>
        <module>coverage-aggregate</module>
      </modules>
    </profile>

    <!-- Maven Central publishing (ADR-0028, #422). Behind a profile so the default reactor build
         (mvn verify in CI, the byte-identical dogfood) is untouched: the source/javadoc/gpg/central
         plugins only activate on `mvn -Prelease ... deploy`. keel-core-java inherits this profile;
         the deploy is scoped to keel-core + this parent pom via `-pl packages/keel-core-java -am`,
         so the reference service and coverage-aggregate are never published. Central requires a
         sources jar, a javadoc jar, and a .asc GPG signature beside the main artifact, plus the
         POM metadata (name/description/url/licenses/developers/scm) declared above; these plugins
         produce the first three. The publish uses the modern Sonatype Central Portal via the
         central-publishing-maven-plugin (the legacy OSSRH/nexus-staging path is retired). -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- Sources jar (Central-required). Managed version from spring-boot-starter-parent. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- Javadoc jar (Central-required). doclint off + failOnError false so the committed
               generated gRPC stubs (io.keel.reference.v1) and terse docs cannot fail the release
               on a javadoc lint warning; Central only needs the jar to exist. Managed version from
               spring-boot-starter-parent. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <doclint>none</doclint>
              <failOnError>false</failOnError>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- Detached GPG signatures (.asc) for every artifact (Central-required). The plugin reads
               the passphrase from the MAVEN_GPG_PASSPHRASE env var (maven-gpg-plugin best-practice
               mode); the private key is imported into the agent's keyring before `mvn deploy` runs
               (the workflow does this from MAVEN_GPG_PRIVATE_KEY). Managed version from
               spring-boot-starter-parent. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- Upload the signed bundle to the Sonatype Central Portal. extensions=true replaces the
               default deploy. publishingServerId=central resolves the Central Portal token from the
               <server id="central"> in settings.xml (username = token user, password = token). The
               plugin rejects re-publishing an existing version (Central is immutable), so the
               release-please wiring runs it once per cut version; a manual re-run of an already
               published version fails fast rather than double-publishing. autoPublish=true promotes
               the deployment from VALIDATED to PUBLISHED without a manual portal click; set it false
               to inspect the staged bundle in the portal before releasing. -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Override Spring Boot's managed RabbitMQ client to the patched release (ADR-0025). The
         spring-boot-dependencies BOM (inherited via spring-boot-starter-parent) manages
         com.rabbitmq:amqp-client to 5.30.0, which carries HIGH CVEs (CVE-2026-63337/69219/69220/
         75516, fixed in 5.33.0-5.34.0). keel-core-java's MessageBus adapter pins 5.38.0 directly,
         but Spring's managed version wins over that transitive version in the reference-service
         image (Trivy gate), so the version property is overridden here to carry the patched client
         to every module in the reactor. 5.38.0 is the current stable. -->
    <rabbit-amqp-client.version>5.38.0</rabbit-amqp-client.version>
    <!-- Override Spring Boot's managed Kafka client to the pinned release (ADR-0025). The
         spring-boot-dependencies BOM (inherited via spring-boot-starter-parent) manages
         org.apache.kafka:kafka-clients to 4.2.2 via this property; keel-core-java's Kafka
         MessageBus adapter pins 4.4.0 directly, but Spring's managed version wins over that
         transitive version in the reference-service image (Trivy gate), so the property is
         overridden here to carry the pinned client to every module in the reactor. 4.4.0 is the
         current stable 4.x line and matches the apache/kafka:4.4.0 KRaft broker the CI starts. -->
    <kafka.version>4.4.0</kafka.version>
    <!-- Per-module JaCoCo floors (epic #419, v0.6 parity). These are the default (keel-core-java)
         minima; reference-service-java overrides them with its own, higher floors in its pom.
         The values lock the real measured coverage just under the observed number so the gate
         blocks any regression; each module sets the highest round value its real coverage clears.
         See the jacoco check rule below for how they are applied. -->
    <jacoco.line.min>0.30</jacoco.line.min>
    <jacoco.branch.min>0.40</jacoco.branch.min>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Force Guava to the latest patched release: the gRPC stack (ADR-0022) pulls a transitive
           guava-android with CVE-2026-102554 (HIGH, DoS), which Trivy flags in the service image.
           33.8.0-jre is the current stable (and the JRE flavor is correct for the JRE runtime). -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.8.0-jre</version>
      </dependency>
      <!-- Force the patched Kafka compression codecs (ADR-0025). kafka-clients 4.4.0 pulls these
           transitively into the reference-service image, where Trivy flags HIGH CVEs in the versions
           it ships: snappy-java 1.1.10.7 (CVE-2026-108106 DoS, CVE-2026-93451 buffer overflow, fixed
           in 1.1.10.9) and lz4-java 1.11.2 (CVE-2026-106451 arbitrary code execution, fixed in
           1.11.4). Spring Boot's BOM does not manage either, so a version property override would not
           take; these direct dependencyManagement pins force the patched versions for every module in
           the reactor so the image resolves them (the groupId is at.yawk.lz4, the maintained lz4-java
           fork Kafka 4.x uses, exactly as Trivy reports it). -->
      <dependency>
        <groupId>org.xerial.snappy</groupId>
        <artifactId>snappy-java</artifactId>
        <version>1.1.10.9</version>
      </dependency>
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>1.11.4</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Format gate (the JVM analog of gofmt/prettier/ruff-format): google-java-format,
           enforced on `mvn verify`. Also strips unused imports. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <java>
            <!-- Generated gRPC stubs (ADR-0022, keel.reference.v1) are committed under
                 io.keel.reference.v1 but owned by buf's protoc/grpc plugins, not held to
                 google-java-format; the buf regeneration dogfood (proto.yml) is their gate. -->
            <excludes>
              <exclude>**/io/keel/reference/**/*.java</exclude>
            </excludes>
            <googleJavaFormat>
              <version>2.0.0</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Coverage report + a per-module hard floor so coverage cannot silently regress. The
           floor is the real measured coverage, rounded down, and set per module via the
           jacoco.line.min / jacoco.branch.min properties (default here, overridden in
           reference-service-java). keel-core-java's web/auth classes (Conformance, SecurityConfig,
           ProblemExceptionHandler, the HTTP-edge filters, CORS) are exercised by the reference
           service's conformance tests, not keel-core's own tests, so its per-module number
           undercounts and sits well below the Python vertical's 85% line floor; a cross-module
           report-aggregate that counts that coverage against keel-core is the path to parity. Until
           then the floor blocks a real regression in either module. -->
      <!-- Measured (mvn verify, Postgres + live Keycloak): keel-core-java LINE 0.3445 / BRANCH
           0.4127; reference-service-java LINE 0.6914 / BRANCH 0.5000. Floors are set just under. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.16</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <!-- Generated protobuf/gRPC stubs (ADR-0022) are not hand-written and are not
                   unit-tested; they would otherwise dilute the per-module floor. Their gate is the
                   buf regeneration dogfood (proto.yml), not coverage. -->
              <excludes>
                <exclude>io/keel/reference/v1/**</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.min}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.branch.min}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
